# Copy to .env (which is gitignored) and fill in.

NODE_ENV=development
AUTH_PORT=3000
LOG_LEVEL=debug
LOG_SERVICE_NAME=auth-service

# Database (Neon pooled endpoint in prod; local Postgres for dev)
AUTH_DB_URL=postgresql://auth:auth@localhost:5432/auth?schema=public

# JWT
AUTH_JWT_SECRET=replace-with-32+-char-secret
AUTH_SERVICE_JWT_SECRET=replace-with-32+-char-secret

# Platform infra
RABBITMQ_URL=amqp://dev:dev@localhost:5672
REDIS_URL=redis://localhost:6379

# Boot-time admin seed (optional in dev; required in prod for first deploy)
AUTH_SEED_ADMIN_EMAIL=
AUTH_SEED_ADMIN_PASSWORD=

# Dev-only token-return flags. REFUSE to start in production if true.
AUTH_RETURN_RESET_TOKEN=true
AUTH_RETURN_VERIFICATION_TOKEN=true
